# Dependencies
node_modules/
.pnpm-store/

# Build — Hostinger generates it on every deploy, it is not versioned
dist/
dist-ssr/
*.local

# Local copies of the plates before they go to the bucket; regenerated by
# scripts/mirror_assets.py
.assets-cache/

# The class form's raw answers. Deliberately NOT versioned: the export carries all
# 34 columns, weight, height and year of birth among them, for twenty-seven people
# who are identifiable by combination — and this repository is public. Publishing
# ten of those columns in src/data/salon.js would be pointless if the other
# twenty-four sat in the git history. See src/data/PROCEDENCIA.txt.
src/data/*.xlsx

# …except the one WE generate. It carries only the 27 publishable columns — the
# same ones src/data/salon.js already publishes — plus the log of every cleaning
# decision, so it is exactly as safe to version as that file, and it is the copy
# the class opens in a spreadsheet. Regenerated by scripts/export_xlsx.py.
!src/data/salon_limpio.xlsx

# Python virtualenvs (helper verification scripts)
.venv/
__pycache__/

# Plans and working material, not published
plans/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Per-machine Claude Code settings: the PATH inside points at one home
# directory, so it is local. The commands and skills of .claude/ are versioned;
# this file is not.
.claude/settings.local.json
