# Dependencies
node_modules/
.pnpm-store/

# Build — Hostinger generates it on every deploy, it is not versioned
dist/
dist-ssr/
*.local

# Local copies of the plates before they go to the bucket; regenerated by
# scripts/mirror_assets.py
.assets-cache/

# Python virtualenvs (helper verification scripts)
.venv/
__pycache__/

# Plans and working material, not published
plans/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Per-machine Claude Code settings: the PATH inside points at one home
# directory, so it is local. The commands and skills of .claude/ are versioned;
# this file is not.
.claude/settings.local.json
