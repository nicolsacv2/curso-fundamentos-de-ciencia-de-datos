# Fundamentos de Ciencia de Datos — configuración de servido estático.
#
# No hay reglas de rewrite: la navegación va por hash (#s1/entrada), así que el
# servidor solo entrega index.html y los assets. No hace falta fallback a SPA.

# ── Compresión ───────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Caché ────────────────────────────────────────────────
# Los bundles llevan hash en el nombre: se pueden cachear para siempre.
# index.html no, o el navegador se quedaría con una versión vieja tras cada despliegue.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

ErrorDocument 404 /index.html
