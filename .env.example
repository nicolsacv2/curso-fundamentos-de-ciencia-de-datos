# Base URLs de las dos APIs de actividades (verquo). Sin barra final.
# Cada actividad es un despliegue aparte, con su propia base de datos.
#
# Sin estas variables la actividad corre en modo local (mock): funciona igual, pero el
# marcador no se comparte entre pantallas. Ver el repo verquo y su DEPLOY.md.
#
# Las URL salen de `make urls ENV=prod` en el repo de verquo.

VITE_DEMERE_API=
VITE_TRIANGLE_API=
